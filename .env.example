# ==============================================================
# Book Driver Anna - Production Environment Configuration Template
# ==============================================================

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# [REQUIRED] JWT Secret for Signing Authentication Tokens (No fallback; server will not start without it: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_production_secret_key

# JWT Token Expiry (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# [REQUIRED] Admin Registration Secret Key (No fallback; server will not start without it. Used to bootstrap initial admin accounts)
ADMIN_REGISTRATION_SECRET=replace_with_secure_admin_bootstrap_key

# Allowed CORS Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# TiDB Cloud Serverless Connection URL (leave blank to use local SQLite)
# Format: mysql://<username>:<password>@<gateway-host>/<database>?ssl={"rejectUnauthorized":true}
DATABASE_URL=

# SQLite Database File Path (used when DATABASE_URL is not set)
DB_PATH=./bda_database.sqlite

# Google Gemini API Key for Anna AI Chatbot (optional, keeps key securely on backend)
# Get key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Production Email Delivery Configuration (Gmail SMTP for Password Reset)
# Get a Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
APP_URL=https://book-driver-anna.vercel.app

# Optional Resend SMTP fallback
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your_resend_api_key
EMAIL_FROM="Book Driver Anna <onboarding@resend.dev>"

